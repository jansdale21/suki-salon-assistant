# Local laptop settings for docker-compose.local.yml. Copy to .env.local (git-ignored).
# Generate random values with:  openssl rand -hex 32   (CREDS_IV: openssl rand -hex 16)
APP_TITLE=Suki · Suklay & Kulay
CUSTOM_FOOTER=Suki is an information assistant for a fictional salon (SAM10 student project). Answers may be wrong — confirm with the front desk.
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false
SEARCH=false
NO_INDEX=true
ENDPOINTS=custom
# Shared token between LibreChat and the gateway (any random string):
SUKI_GATEWAY_KEY=
GATEWAY_TOKEN=
# Your Google AI Studio key (local testing only; in AWS it lives in Parameter Store):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
