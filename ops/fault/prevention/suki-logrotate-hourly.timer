# Housekeeping (secondary): hourly size-capped rotation. On its own it is too slow to stop a fast
# runaway log; the main prevention is isolate-log-volume.sh. Install only AFTER you have investigated
# and confirmed the root cause yourself, then re-run the injector to prove it works:
#   sudo install -m 0644 ops/fault/prevention/suki-logrotate-hourly.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now suki-logrotate-hourly.timer
[Unit]
Description=Run size-capped logrotate for Suki every hour

[Timer]
OnCalendar=hourly
Persistent=true

[Install]
WantedBy=timers.target
